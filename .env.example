# ---------------------------------------------------------------------------
# Stripe — https://dashboard.stripe.com/apikeys
# Use test keys (sk_test_… / pk_test_…) until you are ready to take real money.
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_replace_me
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# Signing secret for /api/webhooks/stripe.
# Local:      stripe listen --forward-to localhost:3000/api/webhooks/stripe
# Production: https://dashboard.stripe.com/webhooks (add the endpoint, copy the secret)
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# ---------------------------------------------------------------------------
# Site URL — used for canonical URLs, OpenGraph tags, the sitemap, and the
# Stripe checkout return_url. Set this to your production domain.
# On Vercel it is inferred from VERCEL_PROJECT_PRODUCTION_URL if omitted.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ---------------------------------------------------------------------------
# Product concierge chat (optional).
# Vercel AI Gateway key: https://vercel.com/docs/ai-gateway
# Not needed when deployed on Vercel with OIDC enabled. Without it, the chat
# widget degrades gracefully and tells visitors to read the detail sheets.
# ---------------------------------------------------------------------------
AI_GATEWAY_API_KEY=
